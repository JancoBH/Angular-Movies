{
  "name": "angular-movies",
  "version": "0.2.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "ng lint",
    "github": "ng build --configuration production,github-pages",
    "postgithub": "node scripts/create-github-pages-404.mjs dist/angular-movies/github-pages",
    "explore": "ng build --named-chunks --source-map && source-map-explorer dist/angular-movies/**/*.js",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "env": "node scripts/write-environment.cjs",
    "env:prod": "node scripts/write-environment.cjs --prod",
    "prestart": "npm run env",
    "prebuild": "npm run env:prod",
    "pregithub": "npm run env:prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/platform-server": "22.0.0",
    "@angular/router": "22.0.0",
    "@angular/service-worker": "22.0.0",
    "rxjs": "^7.8.2",
    "source-map-explorer": "^2.5.3",
    "swiper": "12.1.2",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^9.39.4",
    "@types/google.analytics": "0.0.46",
    "@types/node": "^24.13.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.28.0",
    "jsdom": "^27.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.8"
  }
}
